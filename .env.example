# Local development uses Vite's proxy when unset. Production defaults to the existing Railway backend.
# For a production host that proxies API and socket paths, set VITE_API_URL=/api.
# For a separately hosted backend, use its public API and socket URLs:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
